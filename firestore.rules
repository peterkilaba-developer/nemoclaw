rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════════════
    //  HELPER FUNCTIONS
    // ═══════════════════════════════════════════════

    function isAuthenticated() {
      return request.auth != null;
    }

    // Admin: uses custom Firebase Auth claim (set via Admin SDK) or UID fallback
    function isAdminUser() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'marcus@nemoclaw.com' ||
        request.auth.token.email == 'peterkilaba@gmail.com' ||
        request.auth.token.email == 'peterkilaba@nemoc-law.ai' ||
        request.auth.token.email == 'peterkilaba@nemo-law.ai' ||
        request.auth.token.email == 'partners@davislegal.com'
      );
    }

    // Source of truth: user's /users/{uid} profile must carry the firmId,
    // OR the firm document itself must name this UID as owner.
    function isFirmMember(firmId) {
      return isAdminUser() || (
        isAuthenticated() && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.firmId == firmId ||
          get(/databases/$(database)/documents/firms/$(firmId)).data.ownerId == request.auth.uid ||
          get(/databases/$(database)/documents/firms/$(firmId)).data.ownerUid == request.auth.uid
        )
      );
    }

    // Role-Based Access Control (RBAC) Helpers
    function getUserAgentType() {
      let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return ('agentType' in profile) ? profile.agentType : (('role' in profile) ? profile.role : null);
    }

    function isPracticeDivision() {
      let role = getUserAgentType();
      return role in ['partner', 'managing-partner', 'solo-partner', 'income-partner', 'of-counsel', 'associate', 'senior-associate', 'paralegal', 'law-clerk', 'intern', 'secretary', 'contractor'];
    }

    function isFinanceDivision() {
      let role = getUserAgentType();
      return role in ['billing', 'bookkeeper', 'operations', 'office-manager'];
    }

    function isPartnerRole() {
      let role = getUserAgentType();
      return role in ['partner', 'managing-partner', 'solo-partner', 'income-partner'];
    }

    function isIntakeDivision() {
      let role = getUserAgentType();
      return role in ['intake', 'receptionist', 'secretary', 'paralegal', 'partner', 'managing-partner', 'solo-partner'];
    }

    function isClientCommsUser() {
      let role = getUserAgentType();
      return role in ['intake', 'receptionist', 'secretary', 'paralegal', 'associate', 'senior-associate', 'of-counsel', 'partner', 'managing-partner', 'solo-partner'];
    }

    function isValidPublicWaitlistLead() {
      return request.resource.data.keys().hasAll(['email', 'firmSize', 'practiceAreas', 'selectedTasks', 'location', 'leadScore', 'tier', 'status', 'source', 'createdAt', 'updatedAt']) &&
        request.resource.data.keys().hasOnly(['email', 'firmSize', 'practiceAreas', 'selectedTasks', 'location', 'leadScore', 'tier', 'status', 'source', 'notes', 'followUpDate', 'contactedAt', 'convertedAt', 'createdAt', 'updatedAt']) &&
        request.resource.data.email is string &&
        request.resource.data.email.size() <= 254 &&
        request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$') &&
        request.resource.data.firmSize is string &&
        request.resource.data.firmSize.size() <= 32 &&
        request.resource.data.location is string &&
        request.resource.data.location.size() <= 128 &&
        request.resource.data.practiceAreas is list &&
        request.resource.data.practiceAreas.size() <= 20 &&
        request.resource.data.selectedTasks is list &&
        request.resource.data.selectedTasks.size() <= 20 &&
        request.resource.data.leadScore is number &&
        request.resource.data.leadScore >= 0 &&
        request.resource.data.leadScore <= 100 &&
        request.resource.data.tier in ['hot', 'warm', 'cold'] &&
        request.resource.data.status == 'new' &&
        request.resource.data.source == 'waitlist_form';
    }

    function hasMatterAssignment(data) {
      return isAuthenticated() && (
        (('assignedUserIds' in data) && request.auth.uid in data.assignedUserIds) ||
        (('assignedTo' in data) && request.auth.token.email in data.assignedTo) ||
        (('assignedEmails' in data) && request.auth.token.email in data.assignedEmails)
      );
    }

    function canAccessMatterData(firmId, data) {
      return isFirmOwner(firmId) ||
        (isFirmMember(firmId) && isPracticeDivision() && (isPartnerRole() || hasMatterAssignment(data)));
    }
    // Firm owner only — ownerId/ownerUid match. Role-based bypass removed (was a bug).
    function isFirmOwner(firmId) {
      return isAdminUser() || (
        isAuthenticated() && (
          get(/databases/$(database)/documents/firms/$(firmId)).data.ownerId == request.auth.uid ||
          get(/databases/$(database)/documents/firms/$(firmId)).data.ownerUid == request.auth.uid
        )
      );
    }

    // ═══════════════════════════════════════════════
    //  INTERNAL TOPOLOGY (AgaaS / NemoC Admin Only)
    //  Previously: if true — WORLD PUBLIC. Fixed.
    // ═══════════════════════════════════════════════
    // Support local Daemon simulation by allowing writes with a system secret
    function isSystemDaemon() {
      return request.resource != null && request.resource.data.daemon == 'nemoclaw-system-daemon-xyz';
    }

    match /_internalAgents/{agentId}         { allow read: if isAdminUser(); allow write: if isAdminUser() || isSystemDaemon(); }
    match /_internalAuditLog/{auditId}       { allow read: if isAdminUser(); allow write: if isAdminUser() || isSystemDaemon(); }
    match /_internalEscalations/{escId}      { allow read: if isAdminUser(); allow write: if isAdminUser() || isSystemDaemon(); }
    match /_internalMarketingDrafts/{drafId} { allow read, write: if isAdminUser(); }
    match /_internalStrategicPlans/{planId}  { allow read, write: if isAdminUser(); }
    match /_internalCEAChat/{chatId}         { allow read, write: if isAdminUser(); }
    match /_internalConfig/{configId}        { allow read: if isAdminUser(); allow write: if isAdminUser(); }
    match /_internalXPosts/{postId}          { allow read: if isAdminUser(); allow write: if isAdminUser(); }
    match /_internalLinkedInPosts/{postId}   { allow read: if isAdminUser(); allow write: if isAdminUser(); }
    match /_linkedinQueue/{queueId}          { allow read, write: if isAdminUser(); }

    // Blog Content
    match /published_content/{postId}        { allow read: if true; allow write: if isAdminUser(); }
    match /_publishedPosts/{postId}          { allow read: if true; }
    match /_publicQnA/{qnaId}                { allow read: if true; }

    // Telemetry & Security Engine (System streams)
    match /_telemetryLogs/{logId}            { allow create: if isAuthenticated(); allow read: if isAdminUser(); allow update, delete: if false; }
    match /_securityLogs/{logId}             { allow create: if isAuthenticated(); allow read: if isAdminUser(); allow update, delete: if false; }

    // ═══════════════════════════════════════════════
    //  USER PROFILES
    // ═══════════════════════════════════════════════
    match /users/{userId} {
      // Own profile + same-firm owner can read (for team management)
      allow read: if isAuthenticated() && (
        request.auth.uid == userId ||
        isFirmOwner(get(/databases/$(database)/documents/users/$(userId)).data.firmId)
      );
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (
        request.auth.uid == userId ||
        isFirmOwner(resource.data.firmId)
      );
      allow delete: if false;
    }

    // ═══════════════════════════════════════════════
    //  FIRMS — Institutional Workspace Hierarchy
    //  Previously: isAuthenticated() for read/update — cross-firm leak. Fixed.
    // ═══════════════════════════════════════════════
    match /firms/{firmId} {
      // Only members of THIS firm can read its record
      allow read: if isFirmMember(firmId);
      // Any authenticated user can create (needed for onboarding new firm)
      allow create: if isAuthenticated();
      // Only the owner (ownerId/ownerUid match) can update firm settings
      allow update: if isFirmOwner(firmId);
      allow delete: if false;

      // FIRM CONFIG
      match /config/{configDoc} {
        allow read: if isFirmMember(firmId);
        allow write: if isFirmOwner(firmId);
      }

      // KNOWLEDGE BASE
      match /knowledgeBase/{kbId} {
        allow read: if isFirmMember(firmId);
        allow write: if isFirmOwner(firmId);
      }

      // SUPER AGENT — telemetry config
      match /superAgent/{doc} {
        allow read: if isFirmMember(firmId);
        allow write: if isFirmOwner(firmId);
      }

      // EMPLOYEES
      match /employees/{employeeId} {
        allow read: if isFirmMember(firmId);
        allow create: if isFirmOwner(firmId) || request.auth.uid == employeeId;
        allow update: if isFirmOwner(firmId) || request.auth.uid == employeeId;
        allow delete: if isFirmOwner(firmId);
      }

      // AGENTS — scoped to firm membership; each agent can update their own record
      // Previously: any isAuthenticated() could read/write ANY firm's agents. Fixed.
      match /agents/{agentId} {
        allow read: if isFirmMember(firmId);
        allow create: if isFirmOwner(firmId) || request.auth.uid == agentId;
        allow update: if isFirmOwner(firmId) || request.auth.uid == agentId;
        allow delete: if isFirmOwner(firmId);

        // Agent private chat messages — firm-scoped read, immutable after creation
        match /messages/{messageId} {
          allow read: if isFirmMember(firmId);
          allow create: if isFirmMember(firmId);
          allow update: if false;
          allow delete: if false;
        }
      }

      // MATTERS / CASES — strictly limited to practice division or owners
      match /matters/{matterId} {
        allow read: if canAccessMatterData(firmId, resource.data);
        allow create: if isFirmOwner(firmId) ||
          (isFirmMember(firmId) && isPracticeDivision() && (isPartnerRole() || hasMatterAssignment(request.resource.data)));
        allow update: if canAccessMatterData(firmId, resource.data) &&
          (isFirmOwner(firmId) || isPartnerRole() || hasMatterAssignment(request.resource.data));
        allow delete: if isFirmOwner(firmId);

        // Matter Documents
        match /documents/{docId} {
          allow read, write: if canAccessMatterData(firmId, get(/databases/$(database)/documents/firms/$(firmId)/matters/$(matterId)).data);
        }

        // Public signing is brokered by Cloud Functions; firm users manage requests inside the matter.
        match /signatureRequests/{requestId} {
          allow read, write: if canAccessMatterData(firmId, get(/databases/$(database)/documents/firms/$(firmId)/matters/$(matterId)).data);
        }
      }

      // CLIENT CONTACTS
      match /clients/{clientId} {
        allow read: if isFirmMember(firmId);
        allow write: if isFirmOwner(firmId);
      }

      // INTAKE LEADS
      match /leads/{leadId} {
        allow read, create, update: if isFirmOwner(firmId) || (isFirmMember(firmId) && isIntakeDivision());
        allow delete: if isFirmOwner(firmId);
      }

      // CLIENT PORTAL CHANNELS
      match /clientChannels/{channelId} {
        allow read, write: if isFirmOwner(firmId) || (isFirmMember(firmId) && isClientCommsUser());

        match /messages/{messageId} {
          allow read: if isFirmOwner(firmId) || (isFirmMember(firmId) && isClientCommsUser());
          allow create: if isFirmOwner(firmId) || (isFirmMember(firmId) && isClientCommsUser());
          allow update, delete: if false;
        }
      }

      // LEGAL WORKSPACE ARTIFACTS
      match /drafts/{draftId} {
        allow read, create, update: if isFirmOwner(firmId) || (isFirmMember(firmId) && isPracticeDivision());
        allow delete: if isFirmOwner(firmId);
      }

      match /documentBundles/{bundleId} {
        allow read, create, update: if isFirmOwner(firmId) || (isFirmMember(firmId) && isPracticeDivision());
        allow delete: if isFirmOwner(firmId);
      }

      match /courtForms/{formId} {
        allow read, create, update: if isFirmOwner(firmId) || (isFirmMember(firmId) && isPracticeDivision());
        allow delete: if isFirmOwner(firmId);
      }

      match /conflictChecks/{checkId} {
        allow read: if isFirmOwner(firmId) || (isFirmMember(firmId) && (isPracticeDivision() || isIntakeDivision()));
        allow create: if false;
        allow update, delete: if isFirmOwner(firmId);
      }

      match /trustLedgers/{ledgerId} {
        allow read: if isFirmOwner(firmId) || (isFirmMember(firmId) && isFinanceDivision());
        allow create, update: if isFirmOwner(firmId) || (isFirmMember(firmId) && isFinanceDivision());
        allow delete: if false;
      }

      // BILLING — owner + finance division (financial data)
      match /billing/{billingDoc} {
        allow read, write: if isFirmOwner(firmId) || (isFirmMember(firmId) && isFinanceDivision());
      }

      // BILLABLE ACTIVITIES
      match /billableActivities/{activityId} {
        allow read: if isFirmOwner(firmId) || (isFirmMember(firmId) && isFinanceDivision());
        allow create: if isFirmMember(firmId);
        allow update, delete: if isFirmOwner(firmId) || (isFirmMember(firmId) && isFinanceDivision());
      }

      // CLIENT INVOICES
      match /clientInvoices/{invoiceId} {
        allow read, write: if isFirmOwner(firmId) || (isFirmMember(firmId) && isFinanceDivision());
      }

      // INVOICES (Stripe subscription)
      match /invoices/{invoiceId} {
        allow read, write: if isFirmOwner(firmId) || (isFirmMember(firmId) && isFinanceDivision());
      }

      // AUDIT TRAIL — immutable append, firm-scoped read
      // Previously: any isAuthenticated() could read any firm's audit log. Fixed.
      match /auditLog/{logId} {
        allow read: if isFirmMember(firmId);
        allow create: if isFirmMember(firmId);
        allow update: if false;
        allow delete: if false;
      }
    }

    // ═══════════════════════════════════════════════
    //  PUBLIC / ADMIN (WAITLIST, PROSPECTS, MAIL)
    // ═══════════════════════════════════════════════

    // Waitlist — anyone can submit; authenticated users can read/update
    match /waitlist/{entryId} {
      allow create: if isValidPublicWaitlistLead();
      allow read: if isAdminUser();
      allow update: if isAdminUser();
      allow delete: if isAdminUser();
    }

    // Prospects — strictly locked to GTM operators (admins/Peter/Marcus)
    match /prospects/{prospectId} {
      allow read, write: if isAdminUser();
    }

    // Mail queue — anyone authenticated can queue, only admins can view analytics/update metadata manually
    match /mail/{mailId} {
      allow create: if isAuthenticated();
      allow read, update: if isAdminUser();
      allow delete: if false;
    }

    match /mail_queue/{mailId} {
      allow create: if isAuthenticated();
      allow read, update: if isAdminUser();
      allow delete: if false;
    }

    // Call logs — previously missing rule (silent deny). Fixed.
    match /call_logs/{callId} {
      allow read: if isAdminUser();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // ═══════════════════════════════════════════════
    //  DENY EVERYTHING ELSE (fail-closed)
    // ═══════════════════════════════════════════════
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
